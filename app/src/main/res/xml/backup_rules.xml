<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Dados financeiros, perfil e preferências não participam do backup
        automático do Android. O app usa somente o backup explícito .lcfbackup.
    -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
